# ---------------------------------------------------------------------------
# CertiFlow backend environment (local Windows, NO Docker)
# Copy this file to server/.env and adjust the values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
JWT_SECRET=change-me-in-production

# Local PostgreSQL 16 (installed as a Windows service)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/certiflow

# Local Redis-compatible server (Redis for Windows / Memurai / WSL redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional hosted Redis (takes precedence over HOST/PORT/PASSWORD).
# TLS is enabled automatically for rediss:// URLs, e.g. Upstash:
# REDIS_URL=rediss://default:<password>@<region>-<name>.upstash.io:6379
REDIS_URL=

# auto   -> use BullMQ when Redis answers PING, otherwise the documented sync fallback
# bullmq -> require Redis, fail fast if unreachable
# sync   -> explicit synchronous fallback (no Redis, no BullMQ)
QUEUE_MODE=auto

# Directory for generated certificate PDFs (created automatically)
STORAGE_DIR=./storage/certificates

# Frontend origin, used for the verification URL printed on certificates
PUBLIC_BASE_URL=http://localhost:5173

# Simulated WhatsApp provider: mixed | success | failure | timeout
# mixed -> phone ending 7 = permanent failure, 8 = timeout, 9 = temporary failure
#          on the first attempt, anything else = success
WHATSAPP_MODE=mixed
WHATSAPP_MAX_ATTEMPTS=4
